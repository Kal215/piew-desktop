<UserControl x:Class="Piew.Desktop.App.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="460">
    <Grid Margin="20,10,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Card Ringkas -->
        <Border Grid.Row="0" Style="{DynamicResource MacCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sambungan Satu-Klik IDE"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="AI Agent di editor Anda langsung dapat memanggil MCP PIEW."
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Sambungkan Semua"
                        Style="{DynamicResource MacPrimaryButtonStyle}"
                        Command="{Binding ConnectAllCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="DAFTAR EDITOR TERSEDIA"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="4,0,0,8" />

        <!-- Daftar IDE Items -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding IdeList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource MacCardStyle}" Margin="0,0,0,12" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        
                                        <!-- Status Badge -->
                                        <Border Margin="10,0,0,0"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Background="{DynamicResource SurfaceSecondaryBrush}">
                                            <TextBlock Text="{Binding StatusDescription}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0" />

                                    <TextBlock Text="{Binding ConfigPath}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Tombol Toggle Sambungan -->
                                <Button Grid.Column="1"
                                        Style="{DynamicResource MacSecondaryButtonStyle}"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"
                                        Command="{Binding DataContext.ToggleIdeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Content>
                                        <TextBlock Text="{Binding IsConnected, Converter={x:Null}, FallbackValue='Sambungkan'}" />
                                    </Button.Content>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
