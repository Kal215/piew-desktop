<UserControl x:Class="Piew.Desktop.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Search & Filter Bar -->
            <RowDefinition Height="*" />    <!-- List Kartu Prompt -->
        </Grid.RowDefinitions>

        <!-- Top Filter & Search Bar -->
        <Border Grid.Row="0"
                Style="{DynamicResource MacCardBorderStyle}"
                Margin="0,0,0,10"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" Margin="0,0,10,0"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Background="{DynamicResource SurfaceSecondaryBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         ToolTip="Cari judul, tag, atau isi tugas..." />

                <!-- Category Filter -->
                <ComboBox Grid.Column="1"
                          SelectedItem="{Binding SelectedFilterCategory}"
                          ItemsSource="{Binding CategoriesList}"
                          Margin="0,0,10,0"
                          Padding="6,5" />

                <!-- Total Count Badge -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SurfaceSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6">
                    <TextBlock Text="{Binding PromptsCountText}"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- List Prompt Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredPrompts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource MacCardBorderStyle}"
                                Margin="0,0,0,8"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Kiri: Info Prompt -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <!-- Category Badge -->
                                        <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                                CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="10" FontWeight="Medium"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <!-- Token Badge -->
                                        <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                                                CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding EstimatedTokens, StringFormat={}⚡ {0} tok}"
                                                       FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Deskripsi -->
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />

                                    <!-- Kutipan Task Singkat -->
                                    <TextBlock Text="{Binding Task}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               MaxHeight="36"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               FontStyle="Italic" />
                                </StackPanel>

                                <!-- Kanan: Tombol Aksi Cepat -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="📋 Salin"
                                            Command="{Binding DataContext.CopyPromptFromLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource MacSecondaryButtonStyle}"
                                            Padding="10,6" Margin="0,0,6,0" />
                                    <Button Content="✏️ Edit di Studio"
                                            Command="{Binding DataContext.LoadIntoStudioCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource MacSecondaryButtonStyle}"
                                            Padding="10,6" Margin="0,0,6,0" />
                                    <Button Content="🗑️"
                                            Command="{Binding DataContext.DeletePromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource MacSecondaryButtonStyle}"
                                            Foreground="{DynamicResource DangerBrush}"
                                            Padding="8,6" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
