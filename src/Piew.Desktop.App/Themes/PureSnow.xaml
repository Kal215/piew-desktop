<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema Pure Snow (Putih Bersih Minimalis ala Apple macOS) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FAFAFC" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#F4F4F6" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E5E5EA" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#EEEEF0" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E8E93" />

    <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#34C759" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9500" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF3B30" />

    <!-- macOS Traffic Light Window Buttons -->
    <SolidColorBrush x:Key="TrafficCloseBrush" Color="#FF5F56" />
    <SolidColorBrush x:Key="TrafficMinBrush" Color="#FFBD2E" />
    <SolidColorBrush x:Key="TrafficMaxBrush" Color="#27C93F" />

    <Color x:Key="DropShadowColor">#14000000</Color>
</ResourceDictionary>
