<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema Dark Obsidian (Hitam Pekat Elegan ala macOS Dark Mode) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121214" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1C1F" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#26262B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#33333A" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#28282E" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />

    <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#30D158" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9F0A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF453A" />

    <!-- macOS Traffic Light Window Buttons -->
    <SolidColorBrush x:Key="TrafficCloseBrush" Color="#FF5F56" />
    <SolidColorBrush x:Key="TrafficMinBrush" Color="#FFBD2E" />
    <SolidColorBrush x:Key="TrafficMaxBrush" Color="#27C93F" />

    <Color x:Key="DropShadowColor">#40000000</Color>
</ResourceDictionary>
