<Window x:Class="Piew.Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Piew.Desktop.App.Views"
        mc:Ignorable="d"
        Title="PIEW Desktop • Studio &amp; Agent Hub"
        Height="760" Width="1080"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable, Inter, Segoe UI, sans-serif">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      CornerRadius="10"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Bilah Judul Custom macOS -->
                <RowDefinition Height="Auto" /> <!-- Navigasi Tab Segmented -->
                <RowDefinition Height="*" />    <!-- Konten Tampilan Aktif -->
                <RowDefinition Height="Auto" /> <!-- Bilah Status Bawah -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Title Bar ala macOS -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    MouseDown="TitleBar_MouseDown"
                    Padding="16,14,16,10">
                <Grid>
                    <!-- macOS Traffic Light Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{DynamicResource MacTrafficButtonStyle}"
                                Background="{DynamicResource TrafficCloseBrush}"
                                Click="CloseButton_Click"
                                ToolTip="Tutup Aplikasi"
                                Margin="0,0,8,0" />
                        <Button Style="{DynamicResource MacTrafficButtonStyle}"
                                Background="{DynamicResource TrafficMinBrush}"
                                Click="MinimizeButton_Click"
                                ToolTip="Kecilkan Jendela"
                                Margin="0,0,8,0" />
                        <Button Style="{DynamicResource MacTrafficButtonStyle}"
                                Background="{DynamicResource TrafficMaxBrush}"
                                Click="MaximizeButton_Click"
                                ToolTip="Perbesar / Pulihkan" />
                    </StackPanel>

                    <!-- Judul Aplikasi -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="PIEW"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text=" • Studio Rekayasa Prompt &amp; Pengawas Mutu"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Segmented Pill Tab Navigation ala macOS -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    CornerRadius="8"
                    Padding="3"
                    Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="📝 Studio"
                                 Style="{DynamicResource MacTabRadioButtonStyle}"
                                 GroupName="NavTabs"
                                 IsChecked="True"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="Studio" />
                    <RadioButton Content="📚 Perpustakaan"
                                 Style="{DynamicResource MacTabRadioButtonStyle}"
                                 GroupName="NavTabs"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="Library" />
                    <RadioButton Content="🔬 Laboratorium"
                                 Style="{DynamicResource MacTabRadioButtonStyle}"
                                 GroupName="NavTabs"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="Benchmark" />
                    <RadioButton Content="🔌 Hub MCP &amp; Agen"
                                 Style="{DynamicResource MacTabRadioButtonStyle}"
                                 GroupName="NavTabs"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="AgentMcp" />
                    <RadioButton Content="🛡️ Pengawas Mutu"
                                 Style="{DynamicResource MacTabRadioButtonStyle}"
                                 GroupName="NavTabs"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="Audit" />
                    <RadioButton Content="⚙️ Pengaturan"
                                 Style="{DynamicResource MacTabRadioButtonStyle}"
                                 GroupName="NavTabs"
                                 Command="{Binding SelectTabCommand}"
                                 CommandParameter="Settings" />
                </StackPanel>
            </Border>

            <!-- 3. Tampilan Konten Dinamis -->
            <Grid Grid.Row="2">
                <!-- Tab 1: Studio Rekayasa Prompt -->
                <views:StudioView>
                    <views:StudioView.Style>
                        <Style TargetType="views:StudioView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Studio">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:StudioView.Style>
                </views:StudioView>

                <!-- Tab 2: Perpustakaan Prompt -->
                <views:LibraryView>
                    <views:LibraryView.Style>
                        <Style TargetType="views:LibraryView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Library">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:LibraryView.Style>
                </views:LibraryView>

                <!-- Tab 3: Laboratorium Benchmark -->
                <views:BenchmarkView>
                    <views:BenchmarkView.Style>
                        <Style TargetType="views:BenchmarkView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Benchmark">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:BenchmarkView.Style>
                </views:BenchmarkView>

                <!-- Tab 4: Hub MCP & Agen -->
                <views:AgentMcpView>
                    <views:AgentMcpView.Style>
                        <Style TargetType="views:AgentMcpView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="AgentMcp">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AgentMcpView.Style>
                </views:AgentMcpView>

                <!-- Tab 5: Pengawas Mutu Empiris -->
                <views:AuditView>
                    <views:AuditView.Style>
                        <Style TargetType="views:AuditView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Audit">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:AuditView.Style>
                </views:AuditView>

                <!-- Tab 6: Pengaturan & Tema -->
                <views:SettingsView>
                    <views:SettingsView.Style>
                        <Style TargetType="views:SettingsView">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SettingsView.Style>
                </views:SettingsView>
            </Grid>

            <!-- 4. Bilah Status Bawah -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusBanner}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Column="1"
                               Text="PIEW Desktop Enterprise • .NET 8 Native"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
