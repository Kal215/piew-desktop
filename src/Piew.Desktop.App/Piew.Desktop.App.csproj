<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
    <RootNamespace>Piew.Desktop.App</RootNamespace>
    <AssemblyName>PiewDesktop</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Piew.Desktop.Core\Piew.Desktop.Core.csproj" />
  </ItemGroup>

</Project>
