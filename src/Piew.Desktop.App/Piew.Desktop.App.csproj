<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
    <RootNamespace>Piew.Desktop.App</RootNamespace>
    <AssemblyName>PiewDesktop</AssemblyName>
    
    <!-- Metadata Aplikasi & Identitas Windows -->
    <ApplicationIcon>piew.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>PIEW Desktop Enterprise</Product>
    <Company>PIEW Software Foundation</Company>
    <Authors>Muhammad Riskal Fadhilla</Authors>
    <Description>PIEW Desktop Enterprise Suite - Studio Rekayasa Prompt, Offline Library, Benchmark Lab, MCP Tools Hub, &amp; Quality Gatekeeper</Description>
    <Copyright>Copyright © 2026 PIEW Software Foundation</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Piew.Desktop.Core\Piew.Desktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="piew.ico" />
  </ItemGroup>

</Project>
